# 基本配置
PORT=8080
PASSWORD=
DEBUG=false

# CORS 配置
CORS_ORIGIN=*

# 请求配置
# 注意: /proxy/ 现在也承载视频分片(ts)转发, REQUEST_TIMEOUT 建议调大 (如 30000)。
# 默认 5000ms 对慢速分片偏紧。
REQUEST_TIMEOUT=30000
MAX_RETRIES=2
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
# 源站的 keep-alive 连接池大小 (每个源站主机独立计数), 视频分片复用连接可减少握手/慢启动开销
PROXY_MAX_SOCKETS=32

# 缓存配置
CACHE_MAX_AGE=1d

# 安全配置
BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1
BLOCKED_IP_PREFIXES=192.168.,10.,172.
FILTERED_HEADERS=content-security-policy,cookie,set-cookie,x-frame-options,access-control-allow-origin

# ===== TVBox 支持（/tvbox/config、/tvbox/:key 透传聚合 + m3u8 分片改写）=====
# 对外基础地址：必须与 TVBox 里填写的配置域名一致，且电视能访问。
# 用于生成 config 里的 api 地址、以及把 m3u8 分片/封面改写成走本机 /proxy/ 的绝对地址。
TVBOX_PUBLIC_BASE=https://liuyonglang.cn
# 是否把封面图 vod_pic 也走代理（防图片防盗链），true/false
TVBOX_PROXY_PIC=true
# 改写后 m3u8 播放列表的浏览器/客户端缓存秒数
M3U8_CACHE_SECONDS=3600
# m3u8 主列表递归展开子列表的最大深度
M3U8_MAX_RECURSION=5
